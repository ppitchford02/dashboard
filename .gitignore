__pycache__/
public/
news.tmp
preview/
# Built by .github/workflows/rebuild.yml on its own runner and served from the
# Pages artifact; a committed copy is never published. Confirmed 14 Sept 2026:
# pages-build-deployment last ran 10 Sept, every deployment since is the workflow's.
index.html

# Private creator roster. Deployed as the PICKS_ROSTER Worker secret, never tracked.
picks-roster.json

# The scheduled task's automation token, read at fire time and handed to the page.
# Same value as the PICKS_AGENT_TOKEN Worker secret. Never tracked, never in a prompt.
picks-agent-token.txt

# Local timestamped backups and Graphify exports. Never published. Kept ignored so
# deploy.sh's "git add -A" can never sweep a pre-migration copy of the roster in.
backups/
graphify-out/

# Local evidence bridge between Codex Agent Health and Claude. Receipts and
# outbox instructions may contain private operational detail and are never published.
agent-health/sports-picks.json
agent-health/outbox/

# Freshness-gate index for the scheduled Sports Picks pass. Hashes only, no links,
# but it is per-machine run state and is never published.
agent-health/sports-picks-seen.json

# Private resumable per-post resolution journal.
agent-health/sports-picks-active-run.json
agent-health/sports-picks-report.json
